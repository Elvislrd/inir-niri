{
    "name": "Perfiles",
    "icon": "view_quilt",
    "version": "1.0",
    "author": "Elvislrd",
    "description": "Cambia entre layouts de escritorio. Guarda tu layout actual y vuelve a él cuando quieras.",
    "category": "custom",
    "main": "Perfiles.qml",
    "defaultConfig": {
