{
    "name": "Lyrics Pro",
    "icon": "auto_awesome",
    "version": "1.0",
    "author": "",
    "description": "Second-generation lyrics display — karaoke fill, neon glow, sync offset; independent from the original Lyrics widget",
    "category": "custom",
    "main": "LyricsPro.qml",
    "defaultConfig": {
        "placementStrategy": "free",
        "widgetScale": 100,
        "widgetOpacity": 100,
        "colorMode": "auto",
        "dim": 0,
        "x": 630,
        "y": 300,
        "fontSize": 26,
        "fontFamily": "theme",
        "weight": "medium",
        "italic": false,
        "textCase": "normal",
        "lineSpacing": 0.4,
        "lines": 5,
        "align": "center",
        "scrollStyle": "smooth",
        "activeScale": 1.18,
        "karaoke": true,
        "syncOffset": 0,
        "glow": 55,
        "accent": true,
        "shadow": true,
        "placeholder": true
    },
    "resizableAxes": { "uniform": "widgetScale" },
    "defaultSize": { "width": 660, "height": 230 }
}
